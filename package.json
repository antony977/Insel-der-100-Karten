{
  "name": "insel-der-100-karten",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Insel der 100 Karten – ein 2D-Open-World-Pixel-RPG rund um ein magisches Kartenbuch.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
