    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
